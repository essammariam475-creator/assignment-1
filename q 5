
import 'dart:io';

void main() {
  print("Enter an alphabet:");
  String ch = stdin.readLineSync()!.toLowerCase();

  if (ch == 'a' || ch == 'e' ||
      ch == 'i' || ch == 'o' || ch == 'u') {
    print("The alphabet is a vowel");
  } else {
    print("The alphabet is a consonant");
  }
}

